# Copy to .env and fill in. Never commit .env.
DEALERPULSE_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# The bundled SQLite database (path is relative to the API folder). Docker uses the same file at /app/data.
# On Vercel use a hosted database instead, e.g. postgresql+psycopg://user:password@host:5432/dealerpulse?sslmode=require
DATABASE_URL=sqlite:///data/dealerpulse.db
CORS_ORIGINS=http://localhost:3000
ACCESS_TOKEN_MINUTES=30
MAX_UPLOAD_MB=20
LOGIN_RATE_LIMIT=10 per minute
DEFAULT_RATE_LIMIT=300 per minute
# memory:// is per process. With several workers or instances use redis://host:6379
RATE_LIMIT_STORAGE=memory://
# Set true behind HTTPS (adds HSTS) and when a trusted proxy sets X-Forwarded-For
HTTPS_ONLY=false
TRUST_PROXY=false
STREAM_MAX_SECONDS=300